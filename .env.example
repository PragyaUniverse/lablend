PORT=3000
# Timezone used for opening hours and all displayed times
INSTITUTION_TZ=Asia/Kolkata
# Demo mode shows one-click personas, the demo clock and "Reset demo"
DEMO_MODE=true
# Regenerate demo data on start-up if it is older than this many hours (0 = never)
AUTO_RESEED_HOURS=24
# Optional: Claude-powered assistance (falls back to explainable rules when unset)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Where the JSON database is stored
DB_FILE=./data/db.json
